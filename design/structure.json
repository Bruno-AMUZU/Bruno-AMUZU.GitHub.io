{
  "$note": "Version machine des fiches pages/*.md, lue par le script de vérification. Toute modification d'une fiche doit être reportée ici.",
  "conventions": {
    "frameName": "{page} / {format} / {theme}  — ou, pour un état : {page} ({etat}) / {format} / {theme}",
    "sectionPrefix": "§ ",
    "sectionNote": "Chaque section d'un cadre est un calque nommé '§ <id>' ; le script compare la suite des '§' (ordre du document) à la liste ci-dessous.",
    "componentsPage": "Composants",
    "colorCollection": "Couleurs",
    "lang": "fr"
  },
  "formats": {
    "Desktop": {
      "width": 1440
    },
    "Mobile": {
      "width": 390
    }
  },
  "themes": [
    "Clair",
    "Sombre"
  ],
  "forbiddenEverywhere": [
    {
      "pattern": "\\+?33\\s?[1-9](?:[\\s.]?\\d{2}){4}|0[1-9](?:[\\s.]?\\d{2}){4}",
      "reason": "Téléphone [R]"
    },
    {
      "pattern": "Instagram",
      "reason": "Instagram [R]"
    },
    {
      "pattern": "freelance|Démarrer un projet",
      "reason": "Pas de freelance pour l'instant [R] (CTA = « Me contacter »)"
    },
    {
      "pattern": "Robbie|BDI ?WEAR|Portfolio CMS",
      "reason": "Projet réel : maquette en projets fictifs uniquement"
    }
  ],
  "components": [
    "Button",
    "IconButton",
    "Pill",
    "Tag",
    "TechChip",
    "Field",
    "ChoiceChips",
    "Marque",
    "Header",
    "LangSwitch",
    "PageHeader",
    "SectionHeader",
    "Footer",
    "ServiceCard",
    "StackCard",
    "ProjectCard",
    "LabCard",
    "TimelineCard",
    "CertCard",
    "CaseCard",
    "VideoPlayer",
    "ContactBlock",
    "ChatBubble",
    "ChatPanel",
    "AdminSidebar",
    "AdminTopbar",
    "DataTableRow", "MessageRow",
    "StatusBadge",
    "LangTabs",
    "StatCard"
  ],
  "pages": {
    "404": {
      "spec": "pages/404.md",
      "sections": [
        "header",
        "message",
        "footer"
      ]
    },
    "Accueil": {
      "spec": "pages/accueil.md",
      "sections": [
        "header",
        "hero",
        "services",
        "stack",
        "projets",
        "lab",
        "footer",
        "chat-bubble"
      ],
      "states": {
        "chat ouvert": {
          "sections": [
            "header",
            "hero",
            "services",
            "stack",
            "projets",
            "lab",
            "footer",
            "chat-panel",
            "chat-bubble"
          ]
        },
        "menu ouvert": {
          "formats": [
            "Mobile"
          ],
          "themes": [
            "Clair"
          ],
          "sections": [
            "header",
            "menu-mobile"
          ]
        }
      },
      "forbiddenText": [
        "CV",
        "Pour qui",
        "Envoyer le message",
        "Parlons-en"
      ]
    },
    "À propos": {
      "spec": "pages/a-propos.md",
      "sections": [
        "header",
        "presentation",
        "parcours",
        "competences",
        "certifications",
        "footer",
        "chat-bubble"
      ],
      "forbiddenText": [
        "%"
      ]
    },
    "Projets": {
