# Copier ce fichier en .env puis adapter les valeurs. Le .env n'est jamais commité.

APP_ENV=dev

# Adresse publique du site (liens dans les e-mails), sans / final
APP_URL=http://localhost:8090

# Base de données (DB_HOST=db : nom du service dans docker-compose.yml)
DB_HOST=db
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=change-moi

# E-mails : Mailpit en développement, vrai SMTP en production
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@brunoamuzu.fr
MAIL_FROM_NAME=Portfolio Bruno Amuzu

# Ports sur ta machine (à changer si un autre projet les occupe déjà)
APP_PORT=8090
MAILPIT_PORT=8026
ADMINER_PORT=8091

# Compte admin créé par bin/seed.php (développement uniquement)
SEED_ADMIN_EMAIL=admin@portfolio.test
SEED_ADMIN_PASSWORD=dev-Z1yIxtEWz48V
