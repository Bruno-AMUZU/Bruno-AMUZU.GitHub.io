# Configuration de production. Copier en .env sur le serveur (jamais dans git), puis chmod 600 .env.
# Mots de passe à générer sur le serveur : openssl rand -hex 24

APP_ENV=prod

# Docker : fichier et nom du projet utilisés par `docker compose`, bin/backup.sh et bin/deploy-docker.sh
COMPOSE_FILE=compose.prod.yaml
COMPOSE_PROJECT_NAME=portfolio

# Adresse publique du site, sans / final (liens des e-mails, SEO)
APP_URL=https://brunoamuzu.fr

# Base de données : le conteneur « db » de compose.prod.yaml (créée au premier lancement avec ces valeurs)
DB_HOST=db
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=

# Serveur d'envoi d'e-mails (hébergeur ou service : Brevo, Mailjet…). Port 587 (STARTTLS) ou 465 (SSL).
# Le domaine d'envoi doit avoir ses enregistrements SPF et DKIM (voir docs/DEPLOIEMENT.md).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@brunoamuzu.fr
MAIL_FROM_NAME=Portfolio Bruno Amuzu
